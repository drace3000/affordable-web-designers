---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TechCard from '../components/TechCard.astro';
import Button from '../components/Button.astro';
import AWD from '../components/AWD.astro';

const services = [
  {
    title: "Custom Web Applications",
    emoji: "🌐",
    description: "Full-stack responsive solutions built with modern frameworks like React, Blazor, and .NET. We focus on scalability and mobile-first design.",
    features: ["Responsive UI", "API Development", "Cloud-Native"],
    gold: false
  },
  {
    title: "Business Process Automation",
    emoji: "⚙️",
    description: "Streamline your workflows and reduce manual labor. We transform complex analog processes into efficient digital experiences.",
    features: ["Workflow Optimization", "Integration", "Error Reduction"],
    gold: true
  },
  {
    title: "Data Management Systems",
    emoji: "🗄️",
    description: "Robust database design and architecture. We specialize in migrating legacy systems (like MS Access) to modern SQL Server environments.",
    features: ["Database Design", "Legacy Migration", "Data Security"],
    gold: false
  },
  {
    title: "Reporting & Analytics",
    emoji: "📊",
    description: "Turn raw data into actionable insights. We build custom dashboards and natural language query interfaces for your data.",
    features: ["Custom Dashboards", "Predictive Analytics", "NLP Queries"],
    gold: true
  },
  {
    title: "Integration Services",
    emoji: "🔗",
    description: "Connect disparate systems for a seamless data flow. We build custom APIs and connectors to link your business tools.",
    features: ["API Connectors", "Third-Party Integration", "Data Sync"],
    gold: false
  }
];
---

<BaseLayout title="Services" description="Explore AWD's range of high-profile business solutions including web apps, automation, and data systems.">
  <Header />

  <main class="pt-32 lg:pt-48">
    <section class="max-w-6xl mx-auto px-6" data-hover-section>
      <SectionHeading 
        tag="Services"
        title="Our Expertise"
        subtitle="We deliver enterprise-grade engineering without the enterprise bureaucracy."
      />

      <div class="grid md:grid-cols-2 gap-8 mb-32">
        {services.map((service, index) => (
          <TechCard title={service.title} emoji={service.emoji} gold={service.gold} class={index === services.length - 1 ? "md:col-span-2" : ""}>
            <p class="mb-6">{service.description}</p>
            <div class="flex flex-wrap gap-2">
              {service.features.map(feature => (
                <span class="px-3 py-1 rounded-full bg-primary-600/20 border border-primary-500/30 text-[10px] font-bold uppercase tracking-widest text-primary-300">
                  {feature}
                </span>
              ))}
            </div>
          </TechCard>
        ))}
      </div>
    </section>

    <!-- Tech Stack Section -->
    <section class="section-padding relative" data-hover-section>
      <div class="absolute inset-0 bg-section-gradient"></div>
      <div class="absolute inset-0 border-y border-primary-500/20"></div>
      
      <div class="relative max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
          <div>
            <SectionHeading 
              tag="Technology"
              title="Modern Stack. Rapid Delivery."
              subtitle="We don't just build software; we engineer business outcomes."
            />
            <ul class="space-y-4">
              <li class="flex items-center gap-4 glass-panel p-4 rounded-xl">
                <span class="text-gold-400 text-xl">✨</span>
                <span class="text-gray-300">React & Next.js for high-performance UIs</span>
              </li>
              <li class="flex items-center gap-4 glass-panel p-4 rounded-xl">
                <span class="text-gold-400 text-xl">✨</span>
                <span class="text-gray-300">Tailwind CSS for sleek, responsive design</span>
              </li>
              <li class="flex items-center gap-4 glass-panel p-4 rounded-xl">
                <span class="text-gold-400 text-xl">✨</span>
                <span class="text-gray-300">SQL Server & .NET for enterprise reliability</span>
              </li>
            </ul>
          </div>
          
          <!-- Decorative tech illustration -->
          <div class="glass-panel p-8 aspect-square flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-primary-600/10 to-gold-500/10"></div>
            <div class="relative w-full h-full flex items-center justify-center">
              <div class="w-48 h-48 rounded-full border-2 border-dashed border-primary-500/30 flex items-center justify-center animate-spin" style="animation-duration: 30s;">
                <div class="w-32 h-32 rounded-full border border-gold-500/40 flex items-center justify-center">
                  <div class="text-5xl font-black">
                    <AWD />
                  </div>
                </div>
              </div>
              <!-- Orbiting dots -->
              <div class="absolute w-4 h-4 rounded-full bg-gold-500 top-1/4 right-1/4 animate-pulse"></div>
              <div class="absolute w-3 h-3 rounded-full bg-primary-400 bottom-1/3 left-1/4 animate-pulse" style="animation-delay: 0.5s;"></div>
              <div class="absolute w-2 h-2 rounded-full bg-gold-400 top-1/3 left-1/3 animate-pulse" style="animation-delay: 1s;"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding text-center">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold mb-8">Have a custom requirement?</h2>
        <p class="text-gray-400 text-lg mb-12">
          Let's discuss how we can build a solution tailored specifically to your needs.
        </p>
        <Button href="/contact">Get a Free Consultation</Button>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
