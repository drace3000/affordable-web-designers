---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import AWD from '../../components/AWD.astro';
---

<BaseLayout title="Bausch & Lomb International Division Case Study">
  <Header />

  <main class="pt-32 lg:pt-48">
    <article class="max-w-4xl mx-auto px-6" data-hover-section>
      <a href="/case-studies" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-300 hover:text-gold-400 transition-colors mb-8 group">
        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Back to Work
      </a>
      <div class="flex items-center gap-4 mb-6">
        <img src="/bl-logo.png" alt="Bausch & Lomb logo" class="h-10 w-auto drop-shadow-lg" loading="lazy" />
        <p class="text-sm uppercase tracking-[0.2em] text-gray-400 font-semibold">Global Operations</p>
      </div>

      <SectionHeading 
        tag="Case Study"
        title="Bausch & Lomb International Division"
        subtitle="Global operations transformation across 38 international sales and marketing locations."
      />

      <div class="grid md:grid-cols-3 gap-6 mb-16">
        <div class="glass-panel p-6 text-center">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-2">Communication</div>
          <div class="text-gradient-gold font-black text-2xl">+45%</div>
        </div>
        <div class="glass-panel-gold p-6 text-center">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-2">Reporting Time</div>
          <div class="text-gradient-gold font-black text-2xl">-50%</div>
        </div>
        <div class="glass-panel p-6 text-center">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-2">Inventory Reduction</div>
          <div class="text-gradient-gold font-black text-2xl">-40%</div>
        </div>
      </div>

      <div class="prose prose-invert prose-lg max-w-none mb-32">
        <div class="glass-panel p-8 mb-12">
          <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center text-sm">🚀</span>
            The Opportunity
          </h3>
          <p class="text-gray-300 leading-relaxed">
            Bausch & Lomb's International Division needed innovative systems to streamline global operations across 38 sales and marketing locations worldwide. <AWD /> personally led the <span class="text-gold-400 font-semibold">design, development, international installation, and training</span>—traveling to locations globally to deploy technology and empower personnel.
          </p>
        </div>

        <h3 class="text-2xl font-bold text-white mb-6">Accomplishments</h3>
        <div class="grid sm:grid-cols-2 gap-6 mb-12">
          <div class="glass-panel p-6 border-l-4 border-l-gold-500">
            <h4 class="text-white font-bold mb-2 uppercase tracking-[0.2em] text-sm">Global Operations & Communications</h4>
            <p class="text-gray-400 text-sm">
              Led design and development of innovative global operations systems. Traveled to international sales locations to install technology and train personnel, resulting in a 45% increase in international communication through the B&L Worldcom Network.
            </p>
          </div>
          <div class="glass-panel p-6 border-l-4 border-l-primary-500">
            <h4 class="text-white font-bold mb-2 uppercase tracking-[0.2em] text-sm">Global Financial Reporting</h4>
            <p class="text-gray-400 text-sm">
              Cut global monthly financial reporting time in half, enabling quicker corporate decision-making and accelerating strategic initiatives across the organization.
            </p>
          </div>
          <div class="glass-panel-gold p-6 sm:col-span-2">
            <h4 class="text-white font-bold mb-2 uppercase tracking-[0.2em] text-sm flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-gold-500/20 flex items-center justify-center text-xs">📦</span>
              Supply Chain Optimization
            </h4>
            <p class="text-gray-200 text-sm">
              Spearheaded the design and implementation of a Just-in-Time Distribution Resource Planning strategy, slashing inventory by 40% across 38 sales and marketing locations worldwide—markedly boosting operational efficiency and decreasing on-hand inventory costs.
            </p>
          </div>
        </div>

        <!-- Quote -->
        <div class="glass-panel-gold p-8 lg:p-12 relative overflow-hidden mb-16">
          <div class="absolute top-0 right-0 w-40 h-40 bg-gold-500/20 rounded-full blur-[80px]"></div>
          <div class="absolute bottom-0 left-0 w-32 h-32 bg-primary-500/20 rounded-full blur-[60px]"></div>
          <div class="text-5xl text-gold-500/30 absolute top-4 left-6 font-serif">"</div>
          <blockquote class="relative z-10">
            <p class="text-xl lg:text-2xl text-white font-medium italic mb-6 leading-relaxed">
              These systems transformed how our international division operates. Faster reporting, leaner inventory, and seamless global communication—all delivered hands-on across our worldwide locations.
            </p>
            <footer class="text-gold-400 text-sm font-bold uppercase tracking-widest">— Bausch & Lomb International Division</footer>
          </blockquote>
        </div>
      </div>
    </article>

    <section class="section-padding text-center relative">
      <div class="absolute inset-0 border-t border-primary-500/20"></div>
      <div class="relative max-w-4xl mx-auto px-6">
        <h2 class="text-3xl font-bold mb-8">Ready to transform your <span class="text-gradient-gold">global operations</span>?</h2>
        <a href="/contact" class="btn-primary-sleek inline-flex items-center gap-2 group">
          Let's Discuss Your Project
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

