---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import AWD from '../../components/AWD.astro';
---

<BaseLayout title="Community Wellness Center Case Study">
  <Header />

  <main class="pt-32 lg:pt-48">
    <article class="max-w-4xl mx-auto px-6">
      <SectionHeading 
        tag="Case Study"
        title="Community Wellness Center"
        subtitle="Transforming data tracking into strategic business intelligence."
      />

      <div class="grid md:grid-cols-3 gap-6 mb-16">
        <div class="glass-panel p-6 text-center">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-2">Industry</div>
          <div class="text-white font-semibold">Healthcare & Fitness</div>
        </div>
        <div class="glass-panel-gold p-6 text-center">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-2">Timeline</div>
          <div class="text-gradient-gold font-bold text-xl">3 Weeks</div>
        </div>
        <div class="glass-panel p-6 text-center">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-2">Key Result</div>
          <div class="text-white font-semibold">Instant Answers</div>
        </div>
      </div>

      <div class="prose prose-invert prose-lg max-w-none mb-32">
        <div class="glass-panel p-8 mb-12">
          <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center text-sm">📋</span>
            The Challenge
          </h3>
          <p class="text-gray-300 leading-relaxed">
            The Community Wellness Center initially asked for a simple way to track attendance. However, they soon realized they were sitting on an information goldmine but had no way to extract actionable insights from it.
          </p>
        </div>

        <h3 class="text-2xl font-bold text-white mb-6">The "Information Goldmine"</h3>
        <div class="grid sm:grid-cols-2 gap-6 mb-12">
          <div class="glass-panel p-6 border-l-4 border-l-gold-500">
            <h4 class="text-white font-bold mb-2 uppercase tracking-widest text-sm">📈 Predictive Analytics</h4>
            <p class="text-gray-400 text-sm">Identify at-risk members before they churn, allowing for proactive retention.</p>
          </div>
          <div class="glass-panel p-6 border-l-4 border-l-primary-500">
            <h4 class="text-white font-bold mb-2 uppercase tracking-widest text-sm">💬 Natural Language Queries</h4>
            <p class="text-gray-400 text-sm">Ask complex questions in plain English and receive instant data visualisations.</p>
          </div>
          <div class="glass-panel p-6 border-l-4 border-l-primary-500">
            <h4 class="text-white font-bold mb-2 uppercase tracking-widest text-sm">📅 Capacity Planning</h4>
            <p class="text-gray-400 text-sm">Analyze peak usage patterns to optimize staff scheduling and program offerings.</p>
          </div>
          <div class="glass-panel p-6 border-l-4 border-l-gold-500">
            <h4 class="text-white font-bold mb-2 uppercase tracking-widest text-sm">💰 Revenue Attribution</h4>
            <p class="text-gray-400 text-sm">Connect attendance trends directly to financial outcomes and member lifetime value.</p>
          </div>
        </div>

        <!-- Quote -->
        <div class="glass-panel-gold p-8 lg:p-12 relative overflow-hidden mb-16">
          <div class="absolute top-0 right-0 w-40 h-40 bg-gold-500/20 rounded-full blur-[80px]"></div>
          <div class="absolute bottom-0 left-0 w-32 h-32 bg-primary-500/20 rounded-full blur-[60px]"></div>
          <div class="text-5xl text-gold-500/30 absolute top-4 left-6 font-serif">"</div>
          <blockquote class="relative z-10">
            <p class="text-xl lg:text-2xl text-white font-medium italic mb-6 leading-relaxed">
              We asked for attendance tracking. <AWD /> delivered an information goldmine that transformed how we understand and serve our members.
            </p>
            <footer class="text-gold-400 text-sm font-bold uppercase tracking-widest">— Executive Director, CWC</footer>
          </blockquote>
        </div>
      </div>
    </article>

    <section class="section-padding text-center relative">
      <div class="absolute inset-0 border-t border-primary-500/20"></div>
      <div class="relative max-w-4xl mx-auto px-6">
        <h2 class="text-3xl font-bold mb-8">Ready to turn your data into <span class="text-gradient-gold">intelligence</span>?</h2>
        <Button href="/contact">Get Started Today</Button>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
