---
interface Props {
  tag?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
  class?: string;
}

const { tag, title, subtitle, centered = false, class: className } = Astro.props;
---

<div class:list={[
  centered ? "text-center" : "text-left",
  "mb-12 lg:mb-16",
  className
]}>
  {tag && (
    <div class:list={[
      "section-tag inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-widest mb-6",
      "bg-gradient-to-r from-primary-600/20 to-primary-500/10 border border-primary-500/30 text-primary-300",
      centered ? "mx-auto" : ""
    ]}>
      <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-pulse"></span>
      {tag}
    </div>
  )}
  <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">{title}</h2>
  {subtitle && (
    <p class:list={[
      "text-lg text-gray-400 max-w-2xl leading-relaxed",
      centered ? "mx-auto" : ""
    ]}>
      {subtitle}
    </p>
  )}
</div>

<style is:global>
  @keyframes section-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-10px) scale(1.05); }
  }
  
  .section-tag {
    transition: all 0.3s ease;
  }
  
  [data-hover-section]:hover .section-tag {
    animation: section-float 1.5s ease-in-out infinite !important;
    box-shadow: 0 0 25px rgba(251, 191, 36, 0.5), 0 0 50px rgba(59, 130, 246, 0.3) !important;
    border-color: rgba(251, 191, 36, 0.5) !important;
  }
</style>
