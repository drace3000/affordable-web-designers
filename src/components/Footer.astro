---
import AWD from './AWD.astro';
---

<footer class="relative mt-20 border-t border-primary-500/20">
  <div class="absolute inset-0 bg-gradient-to-t from-primary-950/80 to-transparent pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-6 py-12 flex flex-col md:flex-row justify-between items-center gap-6 text-sm">
    <div class="font-black text-xl tracking-tighter">
      <AWD />
    </div>
    <div class="flex gap-8">
      <a href="/services" class="text-gray-400 hover:text-gold-400 transition-colors">Services</a>
      <a href="/case-studies" class="text-gray-400 hover:text-gold-400 transition-colors">Work</a>
      <a href="/about" class="text-gray-400 hover:text-gold-400 transition-colors">About</a>
      <a href="/contact" class="text-gray-400 hover:text-gold-400 transition-colors">Contact</a>
    </div>
    <div class="text-gray-500">© {new Date().getFullYear()} Affordable Web Designer.</div>
  </div>
</footer>
