---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  class?: string;
}

const { stats, class: className } = Astro.props;
---

<div class:list={["grid grid-cols-2 gap-6", className]}>
  {stats.map(stat => (
    <div class="space-y-1 text-center glass-panel p-4">
      <div class="stat-value">{stat.value}</div>
      <div class="stat-label">{stat.label}</div>
    </div>
  ))}
</div>
