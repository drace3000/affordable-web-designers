---
import AWD from './AWD.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/services", label: "Services" },
  { href: "/case-studies", label: "Work" },
  { href: "/about", label: "About" },
];

function isActive(href: string): boolean {
  if (href === "/") {
    return pathname === "/";
  }
  return pathname.startsWith(href);
}
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-6 px-4 pointer-events-none">
  <nav class="pointer-events-auto nav-glass flex items-center gap-6 px-6 py-3 rounded-full transition-all duration-300">
    <a href="/" class="font-black tracking-tighter text-xl"><AWD /></a>
    <div class="h-4 w-px bg-primary-500/30 mx-2"></div>
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <a href={link.href} class:list={[
          "text-sm font-medium transition-colors",
          isActive(link.href) ? "text-gold-400" : "text-gray-300 hover:text-gold-400"
        ]}>{link.label}</a>
      ))}
    </div>
    <a href="/contact" class:list={[
      "text-sm px-5 py-2 transition-all",
      isActive("/contact") ? "btn-primary-sleek ring-2 ring-gold-400/50" : "btn-primary-sleek"
    ]}>Get Quote</a>
  </nav>
</header>
