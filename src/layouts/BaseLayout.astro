---
interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Affordable Web Designer - High-profile business solutions at a fraction of the cost" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Affordable Web Designer" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title} | AWD</title>
    
    <!-- Global Styles -->
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body class="bg-hero-gradient min-h-screen">
    <!-- Decorative Background Elements -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
      <!-- Top-right blue glow -->
      <div class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-primary-500/20 rounded-full blur-[120px] animate-pulse-glow"></div>
      <!-- Bottom-left gold glow -->
      <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-gold-500/10 rounded-full blur-[100px] animate-float"></div>
      <!-- Center blue accent -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-primary-600/10 rounded-full blur-[150px]"></div>
    </div>
    
    <!-- Main Content -->
    <slot />
  </body>
</html>
